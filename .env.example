# Topology profiles: shared-router, direct-cable, or esp-http.
# Auto-detection is safe in shared-router/esp-http and never starts authoritative
# DHCP by itself. direct-cable requires an explicit isolated PXE_INTERFACE.
PXE_PROFILE=shared-router
PXE_INTERFACE=auto
PXE_UPLINK_INTERFACE=auto
PXE_SERVER_IP=auto
PXE_SUBNET=auto
PXE_NETMASK=auto
PXE_CLIENT_MAC=a0:48:1c:97:e6:95
# Optional fixed address/hostname substitute for routed esp-http client access.
# PXE_CLIENT_IP=192.168.1.104

# These three values are used only by direct-cable. In that profile,
# replace PXE_INTERFACE=auto with the isolated Ethernet adapter (for example en5).
PXE_DHCP_START=192.168.50.100
PXE_DHCP_END=192.168.50.199
PXE_LEASE=12h
PXE_HTTP_PORT=8080
# Use auto for the resolved server IP, or a stable router DNS name such as
# http://pxeboot.home.arpa:8080 (required for routed/unicast esp-http).
PXE_BOOT_URL=auto

# TFTP chainloader for shared-router/direct-cable firmware PXE. snponly.efi
# reuses firmware networking. The persistent HP ESP entry uses full ipxe.efi.
IPXE_EFI_BINARY=snponly.efi

# dnsmasq drops root after opening its privileged sockets. By default pxeboot
# uses the invoking Mac user's account so a project under that home is readable.
# Override these only if you create a dedicated service account with access.
# PXE_SERVICE_USER=pxeboot
# PXE_SERVICE_GROUP=pxeboot

# Public key accepted by the temporary installer SSH servers.
SSH_PUBLIC_KEY_FILE=/Users/you/.ssh/id_ed25519.pub

# Installer payloads are fetched by the client directly from vendor servers.
DEBIAN_NETBOOT_URL=https://deb.debian.org/debian/dists/stable/main/installer-amd64/current/images/netboot/debian-installer/amd64
ALPINE_NETBOOT_URL=https://dl-cdn.alpinelinux.org/alpine/latest-stable/releases/x86_64/netboot
ALPINE_REPO_URL=https://dl-cdn.alpinelinux.org/alpine/latest-stable/main
UBUNTU_NETBOOT_URL=https://releases.ubuntu.com/26.04/netboot/amd64
UBUNTU_ISO_URL=https://releases.ubuntu.com/26.04/ubuntu-26.04-live-server-amd64.iso
FEDORA_TREE_URL=https://download.fedoraproject.org/pub/fedora/linux/releases/44/Server/x86_64/os
FEDORA_RDP_USERNAME=installer
# "auto" creates a random runtime-only password under .run/.
FEDORA_RDP_PASSWORD=auto
ARCHISO_URL=https://geo.mirror.pkgbuild.com/iso/latest
