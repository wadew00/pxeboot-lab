# Dedicated, isolated Ethernet interface connected to the PXE client.
# Find it with: ifconfig -l
PXE_INTERFACE=en5
PXE_UPLINK_INTERFACE=en0

# The scripts do not change the Mac's network configuration. Assign this
# address to PXE_INTERFACE before starting the services.
PXE_SERVER_IP=192.168.50.1
PXE_SUBNET=192.168.50.0/24
PXE_NETMASK=255.255.255.0
PXE_DHCP_START=192.168.50.100
PXE_DHCP_END=192.168.50.199
PXE_LEASE=12h
PXE_HTTP_PORT=8080

# UEFI chainloader. snponly.efi reuses the NIC driver from HP firmware and is
# the preferred first try. Change to ipxe.efi if the firmware SNP driver hangs.
IPXE_EFI_BINARY=snponly.efi

# Public key accepted by the temporary installer SSH servers.
SSH_PUBLIC_KEY_FILE=/Users/you/.ssh/id_ed25519.pub

# Installer payloads are fetched by the client directly from vendor servers.
DEBIAN_NETBOOT_URL=https://deb.debian.org/debian/dists/stable/main/installer-amd64/current/images/netboot/debian-installer/amd64
ALPINE_NETBOOT_URL=https://dl-cdn.alpinelinux.org/alpine/latest-stable/releases/x86_64/netboot
ALPINE_REPO_URL=https://dl-cdn.alpinelinux.org/alpine/latest-stable/main
UBUNTU_NETBOOT_URL=https://releases.ubuntu.com/26.04/netboot/amd64
UBUNTU_ISO_URL=https://releases.ubuntu.com/26.04/ubuntu-26.04-live-server-amd64.iso
FEDORA_TREE_URL=https://download.fedoraproject.org/pub/fedora/linux/releases/44/Server/x86_64/os
ARCHISO_URL=https://geo.mirror.pkgbuild.com/iso/latest
