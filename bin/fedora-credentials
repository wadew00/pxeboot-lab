#!/usr/bin/env bash

source "$(cd "$(dirname "$0")" && pwd)/common"
load_env

if [[ "${FEDORA_RDP_PASSWORD}" == auto ]]; then
  password_file="${ROOT_DIR}/.run/fedora-rdp-password"
  [[ -s "${password_file}" ]] || die "credentials not generated; run ./bin/render"
  password="$(<"${password_file}")"
else
  password="${FEDORA_RDP_PASSWORD}"
fi

printf 'Fedora installer RDP username: %s\n' "${FEDORA_RDP_USERNAME}"
printf 'Fedora installer RDP password: %s\n' "${password}"
printf 'Connect an RDP client to CLIENT_IP:3389\n'
