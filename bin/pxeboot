#!/usr/bin/env bash

source "$(cd "$(dirname "$0")" && pwd)/common"

usage() {
  cat <<'EOF'
Usage:
  pxeboot up [target]       Start the complete lab (default target: local)
  pxeboot down              Safely stop the complete lab
  pxeboot restart [target]  Restart the lab
  pxeboot rescue            Start the headless Arch rescue environment
  pxeboot select TARGET     Change the next boot target
  pxeboot TARGET            Shortcut for: pxeboot up TARGET
  pxeboot status            Show services, selection, and client address
  pxeboot leases            Show client address or managed DHCP leases
  pxeboot ssh [IP]          SSH to the most recent installer client
  pxeboot rdp [IP]          Show Fedora RDP endpoint and credentials
  pxeboot logs              Follow HTTP and dnsmasq logs
  pxeboot doctor            Run configuration checks
  pxeboot topology          Show the resolved topology without starting it
  pxeboot profile ...       List, inspect, detect, or select topology profiles
  pxeboot bootstrap         Generate the ESP autoexec.ipxe bootstrap
  pxeboot render            Regenerate runtime files

Targets: local, debian, ubuntu, fedora, arch, alpine, menu
EOF
}

is_target() {
  case "$1" in
    local|debian|ubuntu|fedora|arch|alpine|menu) return 0 ;;
    *) return 1 ;;
  esac
}

selected_target() {
  local selected_file="${ROOT_DIR}/www/selected.ipxe"
  [[ -r "${selected_file}" ]] || return 1
  sed -n 's|.*targets/\([^.]*\)\.ipxe.*|\1|p' "${selected_file}" | head -n 1
}

recent_target() {
  local selected
  selected="$(selected_target || true)"
  if [[ -n "${selected}" && "${selected}" != local && "${selected}" != menu ]]; then
    printf '%s\n' "${selected}"
  elif [[ -r "${ROOT_DIR}/.run/last-target" ]]; then
    head -n 1 "${ROOT_DIR}/.run/last-target"
  else
    return 1
  fi
}

recent_client_ip() {
  if [[ "${PXE_MODE}" != dedicated ]]; then
    if [[ -n "${PXE_CLIENT_IP:-}" ]]; then
      printf '%s\n' "${PXE_CLIENT_IP}"
      return
    fi
    [[ -n "${PXE_CLIENT_MAC:-}" ]] || return 1
    arp -an | awk -v mac="${PXE_CLIENT_MAC}" '
      tolower($4) == tolower(mac) {
        gsub(/[()]/, "", $2)
        print $2
        exit
      }
    '
    return
  fi
  local lease_file="${ROOT_DIR}/.run/dnsmasq.leases"
  [[ -r "${lease_file}" ]] || return 1
  awk 'NF >= 3 { ip=$3 } END { if (ip) print ip }' "${lease_file}"
}

pid_state() {
  local pid_file="$1"
  local pattern="$2"
  if [[ ! -s "${pid_file}" ]]; then
    printf 'down'
    return
  fi
  local pid command
  pid="$(<"${pid_file}")"
  command="$(ps -p "${pid}" -o command= 2>/dev/null || true)"
  if [[ "${command}" == *"${pattern}"* ]]; then
    printf 'up (pid %s)' "${pid}"
  else
    printf 'down (stale pid %s)' "${pid}"
  fi
}

interface_link_state() {
  local state
  state="$(ifconfig "${PXE_INTERFACE}" 2>/dev/null | awk '/status:/ { print $2; exit }')"
  printf '%s\n' "${state:-unknown}"
}

finish_lifecycle() {
  release_lifecycle_lock
  trap - EXIT INT TERM
}

managed_process_running() {
  local pid_file="$1" pattern="$2" pid='' process=''
  [[ -s "${pid_file}" ]] || return 1
  pid="$(<"${pid_file}")"
  [[ "${pid}" =~ ^[0-9]+$ ]] || return 1
  process="$(ps -p "${pid}" -o command= 2>/dev/null || true)"
  [[ "${process}" == *"${pattern}"* ]]
}

session_health_issue() {
  if ! ifconfig "${PXE_INTERFACE}" 2>/dev/null | grep -Fq "inet ${PXE_SERVER_IP} "; then
    printf '%s no longer has %s' "${PXE_INTERFACE}" "${PXE_SERVER_IP}"
    return
  fi
  if ! managed_process_running "${ROOT_DIR}/.run/http.pid" "--directory ${ROOT_DIR}/www"; then
    printf 'HTTP service is not running'
    return
  fi
  if [[ "${PXE_MODE}" != http ]] && \
     ! managed_process_running "${ROOT_DIR}/.run/dnsmasq.pid" "--conf-file=${ROOT_DIR}/build/dnsmasq.conf"; then
    printf 'dnsmasq is not running'
    return
  fi
  if [[ "${PXE_MODE}" == dedicated ]] && [[ ! -s "${ROOT_DIR}/.run/pf-token" ]]; then
    printf 'dedicated NAT state is missing'
    return
  fi
  return 0
}

lab_up() {
  local target="${1:-local}"
  local lock_held="${2:-false}"
  local active_mode_file="${ROOT_DIR}/.run/active-mode"
  local health_issue='' interface_was_up=false nat_was_up=false previous_target
  is_target "${target}" || die "unknown target: ${target}"
  [[ "${lock_held}" == true ]] || acquire_lifecycle_lock
  if use_session_env; then
    load_env
    if [[ "$(sed -n '1p' "${SESSION_STATE_FILE}" 2>/dev/null || true)" != active ]]; then
      die "an incomplete ${PXE_PROFILE} session exists; run pxeboot down first"
    fi
    health_issue="$(session_health_issue)"
    [[ -z "${health_issue}" ]] || \
      die "active session is unhealthy (${health_issue}); run pxeboot restart ${target}"
    "${ROOT_DIR}/bin/select" "${target}"
    printf 'PXE session already active; next target changed to %s.\n' "${target}"
    [[ "${lock_held}" == true ]] || finish_lifecycle
    return
  fi
  load_env
  for stale_state in active-mode pf-token pf-enable-output interface-alias http.pid dnsmasq.pid; do
    [[ ! -e "${ROOT_DIR}/.run/${stale_state}" ]] || \
      die "stale pxeboot state exists (${stale_state}); run pxeboot down before starting"
  done
  write_session_env
  use_session_env
  load_env
  printf 'starting\n' > "${SESSION_STATE_FILE}"
  printf '%s\n' "${PXE_MODE}" > "${active_mode_file}"
  if [[ "${PXE_MODE}" != http ]] && [[ ! -s "${ROOT_DIR}/tftp/${IPXE_EFI_BINARY}" ]]; then
    printf 'Missing UEFI chainloader; downloading %s from iPXE...\n' "${IPXE_EFI_BINARY}"
    "${ROOT_DIR}/bin/fetch-assets" ipxe
  fi
  "${ROOT_DIR}/bin/render"
  previous_target="$(selected_target || printf 'local')"
  "${ROOT_DIR}/bin/select" "${target}"

  if ifconfig "${PXE_INTERFACE}" 2>/dev/null | grep -Fq "inet ${PXE_SERVER_IP} "; then
    interface_was_up=true
  fi
  if ! "${ROOT_DIR}/bin/interface-up"; then
    "${ROOT_DIR}/bin/select" "${previous_target}" || true
    die "interface startup failed; target selection was rolled back"
  fi
  [[ ! -s "${ROOT_DIR}/.run/pf-token" ]] || nat_was_up=true
  if ! "${ROOT_DIR}/bin/nat-up"; then
    "${ROOT_DIR}/bin/nat-down" || true
    [[ "${interface_was_up}" == true ]] || "${ROOT_DIR}/bin/interface-down" || true
    "${ROOT_DIR}/bin/select" "${previous_target}" || true
    die "NAT startup failed; interface change was rolled back"
  fi
  if ! "${ROOT_DIR}/bin/services-up"; then
    [[ "${nat_was_up}" == true ]] || "${ROOT_DIR}/bin/nat-down" || true
    [[ "${interface_was_up}" == true ]] || "${ROOT_DIR}/bin/interface-down" || true
    "${ROOT_DIR}/bin/select" "${previous_target}" || true
    die "service startup failed; network changes were rolled back"
  fi
  printf 'active\n' > "${SESSION_STATE_FILE}"
  link_state="$(interface_link_state)"
  case "${PXE_MODE}" in
    proxy) printf '\nPXE lab is ready on the router LAN. Boot the HP using its iPXE UEFI entry.\n' ;;
    http) printf '\nHTTP boot service is ready. Boot the HP using the enrolled iPXE UEFI entry.\n' ;;
    dedicated) printf '\nPXE lab is ready. Boot the HP using UEFI Network IPv4.\n' ;;
  esac
  if [[ "${link_state}" != active ]]; then
    printf 'WARNING: %s has no active network link (status: %s).\n' "${PXE_INTERFACE}" "${link_state}"
  fi
  printf 'Watch clients: %s status\n' "$0"
  case "${target}" in
    fedora) printf 'After DHCP: %s rdp\n' "$0" ;;
    debian|ubuntu|arch|alpine) printf 'After DHCP: %s ssh\n' "$0" ;;
  esac
  [[ "${lock_held}" == true ]] || finish_lifecycle
}

lab_down() {
  local lock_held="${1:-false}"
  local cleanup_failed=false
  [[ "${lock_held}" == true ]] || acquire_lifecycle_lock
  use_session_env || true
  load_env
  "${ROOT_DIR}/bin/select" local || cleanup_failed=true
  "${ROOT_DIR}/bin/services-down" || cleanup_failed=true
  "${ROOT_DIR}/bin/nat-down" || cleanup_failed=true
  "${ROOT_DIR}/bin/interface-down" || cleanup_failed=true
  if [[ "${cleanup_failed}" == true ]]; then
    die "cleanup was incomplete; session state was retained for another pxeboot down"
  fi
  clear_session_env
  printf 'PXE lab is down; next boot target is local.\n'
  [[ "${lock_held}" == true ]] || finish_lifecycle
}

show_status() {
  local session_state=none
  if use_session_env; then
    session_state="$(sed -n '1p' "${SESSION_STATE_FILE}" 2>/dev/null || true)"
    session_state="${session_state:-unknown}"
  fi
  load_env
  local current_ip='' interface_state=down link_state nat_state=down target=unknown
  printf 'profile   %s (%s)\n' "${PXE_PROFILE}" "${PXE_MODE}"
  printf 'session   %s\n' "${session_state}"
  if ifconfig "${PXE_INTERFACE}" 2>/dev/null | grep -Fq "inet ${PXE_SERVER_IP} "; then
    link_state="$(interface_link_state)"
    interface_state="up (${PXE_INTERFACE} ${PXE_SERVER_IP}; link ${link_state})"
  elif ifconfig "${PXE_INTERFACE}" >/dev/null 2>&1; then
    read -r current_ip _ < <(interface_ipv4_raw "${PXE_INTERFACE}" || true) || true
    interface_state="changed (${PXE_INTERFACE}; session ${PXE_SERVER_IP}; current ${current_ip:-none})"
  fi
  if [[ -s "${ROOT_DIR}/.run/pf-token" ]]; then
    nat_state=up
  elif [[ "${PXE_MODE}" != dedicated ]]; then
    nat_state='not required'
  fi
  target="$(selected_target || printf 'unknown')"
  printf 'boot URL  %s/boot.ipxe\n' "${PXE_BOOT_URL}"
  printf 'target    %s\n' "${target}"
  printf 'interface %s\n' "${interface_state}"
  printf 'NAT       %s\n' "${nat_state}"
  printf 'HTTP      %s\n' "$(pid_state "${ROOT_DIR}/.run/http.pid" "--directory ${ROOT_DIR}/www")"
  if [[ "${PXE_MODE}" == http ]]; then
    printf 'dnsmasq   not required\n'
  else
    printf 'dnsmasq   %s\n' "$(pid_state "${ROOT_DIR}/.run/dnsmasq.pid" "--conf-file=${ROOT_DIR}/build/dnsmasq.conf")"
  fi
  if [[ "${PXE_MODE}" != dedicated ]]; then
    printf '\nClient (router lease):\n'
  else
    printf '\nLeases:\n'
  fi
  "${ROOT_DIR}/bin/leases"
}

installer_ssh() {
  use_session_env || true
  load_env
  local ip="${1:-}" target user
  [[ -n "${ip}" ]] || ip="$(recent_client_ip || true)"
  [[ -n "${ip}" ]] || die "no client IP; boot a target or pass an IP"
  target="$(recent_target || true)"
  case "${target}" in
    debian|ubuntu) user=installer ;;
    fedora|arch|alpine) user=root ;;
    *) die "cannot determine installer SSH user; use ssh user@${ip}" ;;
  esac
  exec ssh "${user}@${ip}"
}

fedora_rdp() {
  use_session_env || true
  load_env
  local ip="${1:-}"
  [[ -n "${ip}" ]] || ip="$(recent_client_ip || true)"
  [[ -n "${ip}" ]] || die "no client IP; boot Fedora or pass an IP"
  "${ROOT_DIR}/bin/fedora-credentials"
  printf 'Fedora installer RDP endpoint: %s:3389\n' "${ip}"
}

show_topology() {
  load_env
  local client_ip='' gateway='' route_interface=''
  route_interface="$(default_route_interface || true)"
  gateway="$(netstat -rn -f inet 2>/dev/null | awk '$1 == "default" { print $2; exit }')"
  client_ip="$(arp -an 2>/dev/null | awk -v mac="${PXE_CLIENT_MAC:-}" '
    tolower($4) == tolower(mac) {
      gsub(/[()]/, "", $2)
      print $2
      exit
    }
  ')"
  printf 'profile       %s (%s)\n' "${PXE_PROFILE}" "${PXE_MODE}"
  printf 'PXE interface %s' "${PXE_INTERFACE}"
  [[ "${PXE_CONFIGURED_INTERFACE}" != auto ]] || printf ' (auto)'
  printf '\nserver        %s\n' "${PXE_SERVER_IP}"
  printf 'subnet        %s (%s)\n' "${PXE_SUBNET}" "${PXE_NETMASK}"
  printf 'boot URL      %s/boot.ipxe\n' "${PXE_BOOT_URL}"
  printf 'default route %s via %s\n' "${route_interface:-unknown}" "${gateway:-unknown}"
  printf 'HP client     %s (%s)\n' "${client_ip:-not in ARP cache}" "${PXE_CLIENT_MAC:-not configured}"
  case "${PXE_MODE}" in
    proxy) printf 'services      router DHCP + Mac ProxyDHCP/TFTP/HTTP; no Mac NAT\n' ;;
    dedicated) printf 'services      Mac DHCP/TFTP/HTTP + NAT through %s\n' "${PXE_UPLINK_INTERFACE}" ;;
    http) printf 'services      router DHCP + ESP bootstrap + Mac HTTP only\n' ;;
  esac
}

generate_bootstrap() {
  acquire_lifecycle_lock
  [[ ! -s "${SESSION_FILE}" ]] || die "a session is active; run pxeboot down before changing the ESP bootstrap"
  use_session_env || true
  load_env
  "${ROOT_DIR}/bin/render"
  printf 'generated %s\n' "${ROOT_DIR}/build/autoexec.ipxe"
  printf 'served copy: %s/autoexec.ipxe\n' "${PXE_BOOT_URL}"
  printf 'ESP destination on HP: /boot/efi/autoexec.ipxe\n'
  finish_lifecycle
}

update_profile_env() {
  local profile="$1" interface="$2" uplink="$3" server_ip="$4"
  local subnet="$5" netmask="$6" boot_url="$7" temporary="${BASE_ENV_FILE}.tmp.$$"
  umask 077
  awk -v profile="${profile}" -v interface="${interface}" -v uplink="${uplink}" \
      -v server_ip="${server_ip}" -v subnet="${subnet}" -v netmask="${netmask}" \
      -v boot_url="${boot_url}" '
    BEGIN {
      keys[1]="PXE_PROFILE"; values[keys[1]]=profile
      keys[2]="PXE_INTERFACE"; values[keys[2]]=interface
      keys[3]="PXE_UPLINK_INTERFACE"; values[keys[3]]=uplink
      keys[4]="PXE_SERVER_IP"; values[keys[4]]=server_ip
      keys[5]="PXE_SUBNET"; values[keys[5]]=subnet
      keys[6]="PXE_NETMASK"; values[keys[6]]=netmask
      keys[7]="PXE_BOOT_URL"; values[keys[7]]=boot_url
    }
    {
      key=$0; sub(/=.*/, "", key)
      if (key in values) { print key "=" values[key]; seen[key]=1; next }
      print
    }
    END { for (i=1; i<=7; i++) if (!seen[keys[i]]) print keys[i] "=" values[keys[i]] }
  ' "${BASE_ENV_FILE}" > "${temporary}"
  mv "${temporary}" "${BASE_ENV_FILE}"
  chmod 600 "${BASE_ENV_FILE}"
}

profile_command() {
  local action="${1:-show}"
  shift || true
  case "${action}" in
    list)
      [[ "$#" -eq 0 ]] || die "usage: pxeboot profile list"
      printf '%-16s %s\n' shared-router 'router DHCP + MAC-scoped ProxyDHCP/TFTP + HTTP'
      printf '%-16s %s\n' direct-cable 'isolated explicit Ethernet + Mac DHCP/NAT + HTTP'
      printf '%-16s %s\n' esp-http 'router DHCP + enrolled ESP iPXE + HTTP only'
      ;;
    show)
      [[ "$#" -eq 0 ]] || die "usage: pxeboot profile show"
      show_topology
      ;;
    detect)
      [[ "$#" -eq 0 ]] || die "usage: pxeboot profile detect"
      [[ -f "${BASE_ENV_FILE}" ]] || die "configuration not found: ${BASE_ENV_FILE}"
      PXE_CLIENT_MAC=''
      # shellcheck disable=SC1090
      source "${BASE_ENV_FILE}"
      local client_interface default_interface
      client_interface="$(client_arp_interface "${PXE_CLIENT_MAC:-}" || true)"
      default_interface="$(default_route_interface || true)"
      if [[ -n "${client_interface}" && "${client_interface}" == "${default_interface}" ]]; then
        printf 'recommended shared-router\n'
        printf 'reason      HP MAC and the default route are both visible on %s\n' "${client_interface}"
      elif [[ -n "${client_interface}" ]]; then
        printf 'recommended esp-http or routed DHCP relay\n'
        printf 'reason      HP is on %s while the default route is %s\n' \
          "${client_interface}" "${default_interface:-unknown}"
      else
        printf 'recommended undetermined\n'
        printf 'reason      HP is not in ARP; choose shared-router or esp-http explicitly\n'
      fi
      printf 'safety      direct-cable is never selected automatically\n'
      ;;
    use)
      [[ "$#" -ge 1 ]] || die "usage: pxeboot profile use PROFILE [INTERFACE|BOOT_URL]"
      acquire_lifecycle_lock
      [[ ! -s "${SESSION_FILE}" ]] || die "a session is active; run pxeboot down before changing profiles"
      local profile="$1"
      shift
      case "${profile}" in
        shared-router)
          [[ "$#" -eq 0 ]] || die "usage: pxeboot profile use shared-router"
          update_profile_env shared-router auto auto auto auto auto auto
          ;;
        direct-cable)
          [[ "$#" -eq 1 ]] || die "usage: pxeboot profile use direct-cable INTERFACE"
          [[ "$1" =~ ^[A-Za-z0-9._:-]+$ ]] || die "invalid interface: $1"
          update_profile_env direct-cable "$1" auto 192.168.50.1 192.168.50.0/24 255.255.255.0 auto
          ;;
        esp-http)
          [[ "$#" -eq 1 ]] || die "usage: pxeboot profile use esp-http http://STABLE-HOST:PORT"
          [[ "$1" == http://* ]] || die "esp-http requires a stable http:// boot URL"
          update_profile_env esp-http auto auto auto auto auto "${1%/}"
          ;;
        *) die "unknown profile: ${profile}" ;;
      esac
      printf 'selected profile %s\n' "${profile}"
      case "${profile}" in
        direct-cable) printf 'isolated interface %s; lab subnet 192.168.50.0/24\n' "$1" ;;
        esp-http) printf 'run pxeboot bootstrap and install it as /boot/efi/autoexec.ipxe on the HP\n' ;;
      esac
      finish_lifecycle
      ;;
    *) die "usage: pxeboot profile [list|show|detect|use PROFILE]" ;;
  esac
}

command_name="${1:-help}"
shift || true

if is_target "${command_name}"; then
  [[ "$#" -eq 0 ]] || die "target shortcut accepts no extra arguments"
  lab_up "${command_name}"
  exit
fi

case "${command_name}" in
  up|start)
    [[ "$#" -le 1 ]] || die "usage: pxeboot up [target]"
    lab_up "${1:-local}"
    ;;
  down|stop)
    [[ "$#" -eq 0 ]] || die "usage: pxeboot down"
    lab_down
    ;;
  restart)
    [[ "$#" -le 1 ]] || die "usage: pxeboot restart [target]"
    restart_target="${1:-$(selected_target || printf 'local')}"
    is_target "${restart_target}" || die "unknown target: ${restart_target}"
    acquire_lifecycle_lock
    lab_down true
    lab_up "${restart_target}" true
    finish_lifecycle
    ;;
  rescue)
    [[ "$#" -eq 0 ]] || die "usage: pxeboot rescue"
    lab_up arch
    printf 'Rescue mode uses the Arch live environment; run %s ssh after DHCP.\n' "$0"
    ;;
  select)
    [[ "$#" -eq 1 ]] || die "usage: pxeboot select TARGET"
    acquire_lifecycle_lock
    "${ROOT_DIR}/bin/select" "$1"
    finish_lifecycle
    ;;
  status)
    [[ "$#" -eq 0 ]] || die "usage: pxeboot status"
    show_status
    ;;
  leases)
    [[ "$#" -eq 0 ]] || die "usage: pxeboot leases"
    use_session_env || true
    "${ROOT_DIR}/bin/leases"
    ;;
  ssh)
    [[ "$#" -le 1 ]] || die "usage: pxeboot ssh [IP]"
    installer_ssh "${1:-}"
    ;;
  rdp)
    [[ "$#" -le 1 ]] || die "usage: pxeboot rdp [IP]"
    fedora_rdp "${1:-}"
    ;;
  logs)
    [[ "$#" -eq 0 ]] || die "usage: pxeboot logs"
    mkdir -p "${ROOT_DIR}/.run"
    [[ -e "${ROOT_DIR}/.run/http.log" ]] || : > "${ROOT_DIR}/.run/http.log"
    [[ -e "${ROOT_DIR}/.run/dnsmasq.log" ]] || : > "${ROOT_DIR}/.run/dnsmasq.log"
    exec tail -F "${ROOT_DIR}/.run/http.log" "${ROOT_DIR}/.run/dnsmasq.log"
    ;;
  doctor)
    [[ "$#" -eq 0 ]] || die "usage: pxeboot doctor"
    exec "${ROOT_DIR}/bin/doctor"
    ;;
  topology)
    [[ "$#" -eq 0 ]] || die "usage: pxeboot topology"
    show_topology
    ;;
  profile)
    profile_command "$@"
    ;;
  bootstrap)
    [[ "$#" -eq 0 ]] || die "usage: pxeboot bootstrap"
    generate_bootstrap
    ;;
  render)
    [[ "$#" -eq 0 ]] || die "usage: pxeboot render"
    [[ ! -s "${SESSION_FILE}" ]] || die "a session is active; use pxeboot restart to apply configuration changes"
    acquire_lifecycle_lock
    "${ROOT_DIR}/bin/render"
    finish_lifecycle
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    die "unknown command: ${command_name}"
    ;;
esac
