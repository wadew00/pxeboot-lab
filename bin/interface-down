#!/usr/bin/env bash

source "$(cd "$(dirname "$0")" && pwd)/common"
load_env
require_command ifconfig

state_file="${ROOT_DIR}/.run/interface-alias"
if [[ -e "${state_file}" ]]; then
  managed_interface="$(sed -n '1p' "${state_file}")"
  managed_ip="$(sed -n '2p' "${state_file}")"
  if [[ ! "${managed_interface}" =~ ^[A-Za-z0-9._:-]+$ ]] || \
     [[ ! "${managed_ip}" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    if [[ "${PXE_MODE}" == dedicated ]] && \
       [[ "${PXE_INTERFACE}" =~ ^[A-Za-z0-9._:-]+$ ]] && \
       [[ "${PXE_SERVER_IP}" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      printf 'WARN recovering malformed interface state from the frozen session\n' >&2
      managed_interface="${PXE_INTERFACE}"
      managed_ip="${PXE_SERVER_IP}"
    else
      rm -f "${state_file}"
      printf 'WARN discarded malformed interface state; no safe address target was available\n' >&2
      exit 0
    fi
  fi
  if ifconfig "${managed_interface}" 2>/dev/null | grep -Fq "inet ${managed_ip} "; then
    sudo ifconfig "${managed_interface}" inet "${managed_ip}" -alias
    printf 'removed managed address %s from %s\n' "${managed_ip}" "${managed_interface}"
  else
    printf '%s does not have managed address %s\n' "${managed_interface}" "${managed_ip}"
  fi
  rm -f "${state_file}"
  exit 0
fi

if [[ "${PXE_MODE}" != dedicated ]]; then
  printf '%s is externally managed in %s; address unchanged\n' "${PXE_INTERFACE}" "${PXE_PROFILE}"
  exit 0
fi

printf 'no pxeboot-managed interface address to remove\n'
