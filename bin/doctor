#!/usr/bin/env bash

source "$(cd "$(dirname "$0")" && pwd)/common"
load_env

failed=0
printf 'profile %s (%s)\n' "${PXE_PROFILE}" "${PXE_MODE}"
commands=(curl python3 tar openssl)
[[ "${PXE_MODE}" == http ]] || commands=(dnsmasq "${commands[@]}")
for command_name in "${commands[@]}"; do
  if command -v "${command_name}" >/dev/null 2>&1; then
    printf 'ok   command %-10s %s\n' "${command_name}" "$(command -v "${command_name}")"
  else
    printf 'FAIL command %s not found\n' "${command_name}"
    failed=1
  fi
done

if [[ "${PXE_MODE}" != http ]]; then
  managed_dnsmasq_pid=''
  [[ ! -s "${ROOT_DIR}/.run/dnsmasq.pid" ]] || managed_dnsmasq_pid="$(<"${ROOT_DIR}/.run/dnsmasq.pid")"
  conflicting_dnsmasq_pids="$(ps ax -o pid=,command= 2>/dev/null | awk -v managed="${managed_dnsmasq_pid}" -v root="${ROOT_DIR}" '
    ($2 ~ /(^|\/)dnsmasq$/) && $1 != managed && index($0, root) { print $1 }
  ')"
  if [[ -n "${conflicting_dnsmasq_pids}" ]]; then
    printf 'FAIL an old pxeboot dnsmasq is still running (pid(s): %s)\n' \
      "$(printf '%s' "${conflicting_dnsmasq_pids}" | tr '\n' ' ')"
    failed=1
  else
    printf 'ok   no conflicting dnsmasq process\n'
  fi
fi

if ifconfig "${PXE_INTERFACE}" >/dev/null 2>&1; then
  printf 'ok   interface %s exists\n' "${PXE_INTERFACE}"
else
  printf 'FAIL interface %s does not exist\n' "${PXE_INTERFACE}"
  failed=1
fi

if ifconfig "${PXE_INTERFACE}" 2>/dev/null | grep -Fq "inet ${PXE_SERVER_IP} "; then
  printf 'ok   interface %s has %s\n' "${PXE_INTERFACE}" "${PXE_SERVER_IP}"
elif [[ "${PXE_MODE}" != dedicated ]]; then
  printf 'FAIL %s interface %s does not have resolved address %s\n' \
    "${PXE_PROFILE}" "${PXE_INTERFACE}" "${PXE_SERVER_IP}"
  failed=1
else
  printf 'WARN interface %s does not currently have %s\n' "${PXE_INTERFACE}" "${PXE_SERVER_IP}"
fi

if [[ "${PXE_MODE}" != dedicated ]]; then
  if [[ "${PXE_MODE}" == proxy ]]; then
    printf 'ok   ProxyDHCP restricted to HP MAC %s\n' "${PXE_CLIENT_MAC}"
  else
    printf 'ok   DHCP/TFTP disabled; ESP iPXE uses %s\n' "${PXE_BOOT_URL}"
    if [[ "${PXE_BOOT_URL}" == "http://${PXE_SERVER_IP}:"* ]]; then
      printf 'WARN esp-http uses a literal Mac IP; reserve it or reinstall autoexec.ipxe after an address change\n'
    fi
  fi
  if [[ -n "${PXE_CLIENT_IP:-}" ]]; then
    printf 'ok   configured HP client address %s\n' "${PXE_CLIENT_IP}"
  elif [[ -n "${PXE_CLIENT_MAC:-}" ]] && command -v arp >/dev/null 2>&1; then
    client_ip="$(arp -an | awk -v mac="${PXE_CLIENT_MAC}" '
      tolower($4) == tolower(mac) {
        gsub(/[()]/, "", $2)
        print $2
        exit
      }
    ')"
    if [[ -n "${client_ip}" ]]; then
      printf 'ok   HP visible through router at %s\n' "${client_ip}"
    else
      printf 'WARN HP is not currently in the Mac ARP cache\n'
    fi
  fi
fi

if [[ -r "${SSH_PUBLIC_KEY_FILE}" ]]; then
  key_fields="$(awk 'NF >= 2 { print $1, $2; exit }' "${SSH_PUBLIC_KEY_FILE}")"
  if [[ "${key_fields}" == ssh-*\ * || "${key_fields}" == ecdsa-*\ * ]]; then
    printf 'ok   SSH public key %s\n' "${SSH_PUBLIC_KEY_FILE}"
  else
    printf 'FAIL %s does not look like an OpenSSH public key\n' "${SSH_PUBLIC_KEY_FILE}"
    failed=1
  fi
else
  printf 'FAIL SSH public key is not readable: %s\n' "${SSH_PUBLIC_KEY_FILE}"
  failed=1
fi

if [[ "${PXE_MODE}" != http ]]; then
  for asset in "tftp/${IPXE_EFI_BINARY}"; do
    if [[ -s "${ROOT_DIR}/${asset}" ]]; then
      printf 'ok   asset %s\n' "${asset}"
    else
      printf 'WARN asset missing: %s\n' "${asset}"
    fi
  done
fi

if [[ -s "${ROOT_DIR}/build/autoexec.ipxe" ]]; then
  printf 'ok   generated ESP bootstrap build/autoexec.ipxe\n'
else
  printf 'WARN ESP bootstrap is missing; run pxeboot render\n'
fi

if [[ -s "${ROOT_DIR}/www/assets/alpine/headless.apkovl.tar.gz" ]]; then
  printf 'ok   generated Alpine SSH overlay\n'
else
  printf 'WARN Alpine SSH overlay is missing; run ./bin/render\n'
fi

exit "${failed}"
