# Generated by bin/render. Do not edit build/dnsmasq.conf directly.
# ProxyDHCP supplies PXE metadata only. The existing router still allocates IPs.
port=0
user=@@PXE_SERVICE_USER@@
group=@@PXE_SERVICE_GROUP@@
interface=@@PXE_INTERFACE@@
except-interface=lo0
bind-interfaces
log-dhcp
dhcp-no-override
dhcp-range=@@PXE_SUBNET_ADDRESS@@,proxy,@@PXE_NETMASK@@
dhcp-leasefile=@@ROOT_DIR@@/.run/dnsmasq.leases
pid-file=@@ROOT_DIR@@/.run/dnsmasq.pid
log-facility=@@ROOT_DIR@@/.run/dnsmasq.log
enable-tftp
tftp-root=@@ROOT_DIR@@/tftp

# Answer only the intended HP. Every other client keeps using the router alone.
dhcp-host=@@PXE_CLIENT_MAC@@,set:pxe-client
dhcp-ignore=tag:!pxe-client

# Option 175 identifies the second-stage iPXE client. Firmware gets the UEFI
# chainloader over TFTP; iPXE gets the selected HTTP boot script.
dhcp-match=set:ipxe,175
tag-if=set:pxe-firmware,tag:pxe-client,tag:!ipxe
tag-if=set:pxe-ipxe,tag:pxe-client,tag:ipxe
pxe-service=tag:pxe-firmware,BC_EFI,"iPXE UEFI",@@IPXE_EFI_BINARY@@,@@PXE_SERVER_IP@@
pxe-service=tag:pxe-firmware,x86-64_EFI,"iPXE UEFI",@@IPXE_EFI_BINARY@@,@@PXE_SERVER_IP@@
dhcp-boot=tag:pxe-ipxe,@@PXE_BOOT_URL@@/boot.ipxe,,@@PXE_SERVER_IP@@
