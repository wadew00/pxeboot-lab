# Generated by bin/render. Do not edit build/dnsmasq.conf directly.
port=0
interface=@@PXE_INTERFACE@@
bind-interfaces
log-dhcp
dhcp-authoritative
dhcp-range=@@PXE_DHCP_START@@,@@PXE_DHCP_END@@,@@PXE_NETMASK@@,@@PXE_LEASE@@
dhcp-option=option:router,@@PXE_SERVER_IP@@
dhcp-option=option:dns-server,1.1.1.1,9.9.9.9
dhcp-leasefile=@@ROOT_DIR@@/.run/dnsmasq.leases
enable-tftp
tftp-root=@@ROOT_DIR@@/tftp

# Option 175 is sent by iPXE. It separates firmware PXE from the second-stage
# request and prevents an iPXE -> iPXE chainloading loop.
dhcp-match=set:ipxe,175
dhcp-match=set:efi64,option:client-arch,7
dhcp-match=set:efi64,option:client-arch,9
dhcp-boot=tag:ipxe,http://@@PXE_SERVER_IP@@:@@PXE_HTTP_PORT@@/boot.ipxe
dhcp-boot=tag:!ipxe,tag:efi64,@@IPXE_EFI_BINARY@@
