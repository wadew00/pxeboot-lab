#!ipxe
set base @@PXE_BOOT_URL@@
set ipxe_ubuntu ${base}/vendor/ubuntu
imgfetch --name pxestatus ${base}/event?stage=ubuntu-kernel-start || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
kernel ${ipxe_ubuntu}/linux ip=dhcp url=@@UBUNTU_ISO_URL@@ ds=nocloud-net;s=${base}/cloud-init/ --- || goto failed
imgfetch --name pxestatus ${base}/event?stage=ubuntu-kernel-loaded || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
imgfetch --name pxestatus ${base}/event?stage=ubuntu-initrd-start || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
initrd ${ipxe_ubuntu}/initrd || goto failed
imgfetch --name pxestatus ${base}/event?stage=ubuntu-initrd-loaded || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
imgfetch --name pxestatus ${base}/event?stage=ubuntu-boot || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
boot || goto failed

:failed
imgfetch --name pxestatus ${base}/event?stage=ubuntu-failed || echo Ubuntu boot failed
imgfree pxestatus || echo Status cleanup skipped
exit 1
