#!ipxe
set base @@PXE_BOOT_URL@@
set ipxe_arch ${base}/vendor/arch
set archiso ${ipxe_arch}
imgfetch --name pxestatus ${base}/event?stage=arch-kernel-start || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
imgfetch --name pxestatus ${base}/event?stage=arch-net-ip-${net0/ip}-gw-${gateway}-dns-${dns} || echo Network status callback failed
imgfree pxestatus || echo Status cleanup skipped
kernel ${ipxe_arch}/arch/boot/x86_64/vmlinuz-linux ip=dhcp BOOTIF=01-${net0/mac:hexhyp} archiso_http_srv=${archiso}/ archisobasedir=arch cms_verify=y ds=nocloud-net;s=${base}/cloud-init/arch/ || goto failed
imgfetch --name pxestatus ${base}/event?stage=arch-kernel-loaded || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
imgfetch --name pxestatus ${base}/event?stage=arch-initrd-start || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
initrd ${ipxe_arch}/arch/boot/x86_64/initramfs-linux.img || goto failed
imgfetch --name pxestatus ${base}/event?stage=arch-initrd-loaded || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
imgfetch --name pxestatus ${base}/event?stage=arch-boot || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
boot || goto failed

:failed
set boot_errno ${errno}
imgfetch --name pxestatus ${base}/event?stage=arch-failed-errno-${boot_errno} || echo Arch boot failed with error ${boot_errno}
imgfree pxestatus || echo Status cleanup skipped
exit 1
