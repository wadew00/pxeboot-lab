#!ipxe
set base @@PXE_BOOT_URL@@
imgfetch --name pxestatus ${base}/event?stage=debian-kernel-start || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
kernel @@DEBIAN_NETBOOT_URL@@/linux auto=true priority=critical interface=auto netcfg/disable_autoconfig=false url=${base}/preseed.cfg --- || goto failed
imgfetch --name pxestatus ${base}/event?stage=debian-kernel-loaded || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
imgfetch --name pxestatus ${base}/event?stage=debian-initrd-start || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
initrd @@DEBIAN_NETBOOT_URL@@/initrd.gz || goto failed
imgfetch --name pxestatus ${base}/event?stage=debian-initrd-loaded || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
imgfetch --name pxestatus ${base}/event?stage=debian-boot || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
boot || goto failed

:failed
imgfetch --name pxestatus ${base}/event?stage=debian-failed || echo Debian boot failed
imgfree pxestatus || echo Status cleanup skipped
exit 1
