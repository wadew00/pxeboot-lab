#!ipxe
set base @@PXE_BOOT_URL@@
set fedora_tree @@FEDORA_TREE_URL@@
set ipxe_fedora ${base}/vendor/fedora
imgfetch --name pxestatus ${base}/event?stage=fedora-kernel-start || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
kernel ${ipxe_fedora}/images/pxeboot/vmlinuz ip=dhcp inst.repo=${fedora_tree} inst.sshd inst.ks=${base}/fedora.ks inst.rdp inst.rdp.username=@@FEDORA_RDP_USERNAME@@ inst.rdp.password=@@FEDORA_RDP_PASSWORD@@ || goto failed
imgfetch --name pxestatus ${base}/event?stage=fedora-kernel-loaded || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
imgfetch --name pxestatus ${base}/event?stage=fedora-initrd-start || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
initrd ${ipxe_fedora}/images/pxeboot/initrd.img || goto failed
imgfetch --name pxestatus ${base}/event?stage=fedora-initrd-loaded || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
imgfetch --name pxestatus ${base}/event?stage=fedora-boot || echo Status callback failed
imgfree pxestatus || echo Status cleanup skipped
boot || goto failed

:failed
imgfetch --name pxestatus ${base}/event?stage=fedora-failed || echo Fedora boot failed
imgfree pxestatus || echo Status cleanup skipped
exit 1
